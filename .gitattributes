# Large binary artifacts
*.pt filter=lfs diff=lfs merge=lfs -text
*.pkl filter=lfs diff=lfs merge=lfs -text

# PDFs are a few megabytes at most and are committed directly; routing them
# through LFS would need the LFS batch API, which the REST API does not expose.

# Text
*.py text eol=lf
*.sh text eol=lf
*.md text eol=lf
*.tex text eol=lf
*.bib text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.cff text eol=lf

# Figures: keep PNG as-is (already compressed)
*.png binary
